{{ if eq .chezmoi.os "darwin" }}
Include ~/.orbstack/ssh/config
{{- end }}

{{- if .isWorkMachine }}
# Include config file generated by owl cli
# Any conflicting entries will be overwritten
Include /Users/valz/.ssh/owl_config
Include /Users/valz/.ssh/work_config
{{- end }}

# PERSO
# ===========
Host github.com
    HostName github.com
    User git
    IdentityFile {{ .chezmoi.homeDir }}/.ssh/github

Host vps
    Hostname {{ (bitwardenFields "item" "VPS SSH").hostname.value }}
    User {{ (bitwardenFields "item" "VPS SSH").user.value }}
    Port {{ (bitwardenFields "item" "VPS SSH").port.value }}
    IdentityFile {{ .chezmoi.homeDir }}/.ssh/vps
    IdentitiesOnly yes

Host nas
    Hostname {{ (index (bitwarden "item" "NAS SSH").login.uris 0).uri }}
    HostKeyAlgorithms=+ssh-rsa
    User {{ (bitwarden "item" "NAS SSH").login.username }}
    Port {{ (bitwardenFields "item" "NAS SSH").port.value }}
