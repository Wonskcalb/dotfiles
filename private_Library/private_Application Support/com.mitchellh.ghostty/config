# Config generated by Ghostty Config

# theming
theme = Glacier
background-opacity = 0.9
background-blur = 20
unfocused-split-opacity = 0.95
split-divider-color = #070D0D

# Quake terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-space-behavior = move
keybind = global:super+ctrl+enter=toggle_quick_terminal

# Clipboard config
clipboard-read = allow
clipboard-write = allow
copy-on-select = false
clipboard-paste-protection = false

# Force zoom bindings
keybind = super+slash=increase_font_size:1.5
keybind = super+equal=decrease_font_size:1.5
keybind = super+digit_0=reset_font_size

# Misc
auto-update = download